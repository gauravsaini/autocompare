{
  "name": "autocompare-desktop-web",
  "version": "0.5.0",
  "private": true,
  "description": "AutoCompare Tauri v2 desktop frontend (React 19 + Vite + Tailwind v4). Wave 0 scaffold.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test src/v2/__tests__/*.test.ts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "test:storybook": "vitest run --project=storybook",
    "test:visual": "playwright test -c playwright.storybook.config.ts",
    "test:visual:update": "playwright test -c playwright.storybook.config.ts --update-snapshots",
    "package:dmg": "bash ../../scripts/build-macos-dmg.sh"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@tanstack/react-virtual": "^3.11.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.1.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/addon-vitest": "^10.6.9",
    "@storybook/react-vite": "^10.6.9",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^5.1.2",
    "playwright": "1.65.1",
    "storybook": "^10.6.9",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.2"
  }
}
