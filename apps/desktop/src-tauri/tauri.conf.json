{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoCompare",
  "version": "0.5.0",
  "identifier": "com.autocompare.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoCompare",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "transparent": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data: blob:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Compare files and folders side by side",
    "longDescription": "AutoCompare desktop shell (Tauri v2). Native macOS diff, merge, table, hex, folder, and media comparison built on a safe Rust engine.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": null,
      "dmg": {
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 480, "y": 200 },
        "windowSize": { "width": 660, "height": 420 }
      }
    },
    "windows": {
      "certificateThumbprint": null
    }
  },
  "plugins": {}
}
